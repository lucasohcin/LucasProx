{
  "version": 2,
  "buildCommand": "npm run build",
  "functions": {
    "server.js": {
      "includeFiles": "public/**"
    },
    "api/*.js": {
      "includeFiles": "public/**"
    }
  },
  "rewrites": [
    {
      "source": "/service/uv/:path*",
      "destination": "/api/proxy?q=:path*"
    },
    {
      "source": "/bare/:path*",
      "destination": "/api/bare"
    }
  ]
}
